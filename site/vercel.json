{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/escuro", "destination": "/escuro.html" },
    { "source": "/claro", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
